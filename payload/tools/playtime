#!/usr/bin/env python3
"""playtime — 记录每个游戏的累计游玩秒数。用法: playtime add <appid> <sec> | playtime get"""
import json, os, sys, tempfile
PAY = os.path.expanduser("~/Library/Application Support/SteamWine")
DB = os.path.join(PAY, "playtime.json")

def load():
    try: return json.load(open(DB, encoding="utf-8"))
    except Exception: return {}

def save(d):
    fd, tmp = tempfile.mkstemp(dir=PAY)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(d, f, ensure_ascii=False, indent=2)
    os.replace(tmp, DB)

def import_steam():
    import glob, re
    steam = os.path.join(os.path.expanduser("~/Library/Application Support/SteamWine"),
                         "SharedSupport/prefix/drive_c/Program Files (x86)/Steam")
    mins, cur = {}, None
    for f in glob.glob(os.path.join(steam, "userdata/*/config/localconfig.vdf")):
        try:
            for line in open(f, encoding="utf-8", errors="ignore"):
                m = re.match(r'\s*"(\d{6,8})"\s*$', line)
                if m: cur = m.group(1); continue
                m = re.match(r'\s*"Playtime"\s*"(\d+)"', line)
                if m and cur: mins[cur] = max(mins.get(cur, 0), int(m.group(1)))
        except Exception: pass
    d = load()
    for k, v in mins.items():
        d[k] = max(d.get(k, 0), v * 60)
    save(d)
    print(f"imported {len(mins)} apps")

if __name__ == "__main__":
    if len(sys.argv) >= 2 and sys.argv[1] == "import":
        import_steam(); raise SystemExit
    if len(sys.argv) >= 4 and sys.argv[1] == "add":
        appid = sys.argv[2]; sec = max(0, int(sys.argv[3]))
        d = load(); d[appid] = d.get(appid, 0) + sec; save(d)
        print(f"{appid} +{sec}s -> {d[appid]}s")
    else:
        print(json.dumps(load(), ensure_ascii=False))
