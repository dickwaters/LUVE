#!/bin/bash
# steamprewarm — 安装时把 Steam 首次更新跑完
#
# 用法: steamprewarm [--timeout 900] [--stall 120] [--quiet] [--dry-run]
#
# 逻辑:
#   1. source $PAY/env.sh 拿 $WINE / $WINEPREFIX
#   2. 确认 Steam.exe 存在
#   3. 记下 bootstrap_log 当前字节/行数，先跑 steamfix auto
#   4. 后台起 "$WINE" "$STEAM_DIR/Steam.exe" -silent
#   5. 每 3 秒看 bootstrap_log 新增内容：
#        - 两条以上 "Nothing to do"，或 "Verification complete" 之后有 "Nothing to do" → ok
#        - 连续 --stall 秒没有新增字节 → stalled
#        - 超过 --timeout 秒 → timeout
#   6. 退出前一定清掉 Steam.exe -silent 的 wine 进程
set -u

PAY="$HOME/Library/Application Support/SteamWine"
TIMEOUT=900
STALL=120
QUIET=0
DRY_RUN=0
TOOLS=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
STEAMFIX="$TOOLS/steamfix"

usage() {
  cat <<'EOF'
用法: steamprewarm [--timeout 900] [--stall 120] [--quiet] [--dry-run]
  --timeout N   最长等待秒数（默认 900）
  --stall N     日志连续 N 秒无新增就判定卡住（默认 120）
  --quiet       只输出最后一行机器可读结果
  --dry-run     只打印会执行的命令，不启动 Wine
EOF
}

say() {
  [ "$QUIET" = 1 ] && return 0
  printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*"
}

WINE_PID=""
CLEANED=0

kill_steam() {
  [ "$CLEANED" = 1 ] && return 0
  CLEANED=1
  if [ -n "${WINE_PID:-}" ]; then
    # 尝试整组杀（wine 是组长时有效），失败再杀单个 pid
    kill -9 "-$WINE_PID" 2>/dev/null
    kill -9 "$WINE_PID" 2>/dev/null
  fi
  pkill -9 -f 'Steam.exe -silent' 2>/dev/null
  sleep 1
}

on_exit() { kill_steam; }

while [ $# -gt 0 ]; do
  case "$1" in
    --timeout)
      [ $# -ge 2 ] || { echo "steamprewarm: --timeout 需要一个数字" >&2; exit 2; }
      TIMEOUT="$2"
      shift
      ;;
    --stall)
      [ $# -ge 2 ] || { echo "steamprewarm: --stall 需要一个数字" >&2; exit 2; }
      STALL="$2"
      shift
      ;;
    --quiet)   QUIET=1 ;;
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "steamprewarm: 未知参数 $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

case "$TIMEOUT" in ''|*[!0-9]*) echo "steamprewarm: --timeout 必须是整数" >&2; exit 2 ;; esac
case "$STALL" in ''|*[!0-9]*) echo "steamprewarm: --stall 必须是整数" >&2; exit 2 ;; esac
[ "$TIMEOUT" -gt 0 ] || { echo "steamprewarm: --timeout 必须大于 0" >&2; exit 2; }
[ "$STALL" -gt 0 ] || { echo "steamprewarm: --stall 必须大于 0" >&2; exit 2; }

# shellcheck disable=SC1091
source "$PAY/env.sh" || { echo "steamprewarm: 读不到 $PAY/env.sh" >&2; exit 2; }

STEAM_DIR="$WINEPREFIX/drive_c/Program Files (x86)/Steam"
STEAM_EXE="$STEAM_DIR/Steam.exe"
LOG="$STEAM_DIR/logs/bootstrap_log.txt"

if [ ! -f "$STEAM_EXE" ]; then
  say "❌ Steam 没装上：找不到 $STEAM_EXE"
  [ "$QUIET" = 1 ] && echo "prewarm=no_steam"
  exit 3
fi

if [ "$DRY_RUN" = 1 ]; then
  say "dry-run：不会启动 Wine，只打印将要执行的命令"
  echo "steamfix: $STEAMFIX auto"
  echo "wine:     \"$WINE\" \"$STEAM_EXE\" -silent"
  echo "log:      $LOG"
  echo "timeout:  ${TIMEOUT}s  stall: ${STALL}s"
  exit 0
fi

trap 'kill_steam' EXIT
trap 'kill_steam; exit 130' INT TERM

START_LINES=0
START_BYTES=0
if [ -f "$LOG" ]; then
  START_LINES=$(wc -l <"$LOG" 2>/dev/null | tr -d ' ')
  START_BYTES=$(wc -c <"$LOG" 2>/dev/null | tr -d ' ')
fi
[ -n "$START_LINES" ] || START_LINES=0
[ -n "$START_BYTES" ] || START_BYTES=0

say "Steam: $STEAM_EXE"
say "bootstrap_log 起始：${START_LINES} 行 / ${START_BYTES} 字节"
say "先清理坏状态…"
if [ "$QUIET" = 1 ]; then
  "$STEAMFIX" auto >/dev/null 2>&1
else
  "$STEAMFIX" auto
fi

say "后台启动 Steam（-silent）…"
"$WINE" "$STEAM_EXE" -silent >/dev/null 2>&1 &
WINE_PID=$!
say "wine pid=${WINE_PID}，每 3 秒看一次日志（timeout=${TIMEOUT}s stall=${STALL}s）"

START_TS=$(date +%s)
LAST_CHANGE=$START_TS
LAST_SIZE=$START_BYTES
NEXT_NOTE=$((START_TS + 30))

while :; do
  sleep 3
  NOW=$(date +%s)
  ELAPSED=$((NOW - START_TS))

  SIZE=0
  [ -f "$LOG" ] && SIZE=$(wc -c <"$LOG" 2>/dev/null | tr -d ' ')
  [ -n "$SIZE" ] || SIZE=0

  if [ "$SIZE" -lt "$LAST_SIZE" ]; then
    # 日志被轮转/截断：从 0 重新算新增，避免误判
    START_BYTES=$SIZE
    LAST_SIZE=$SIZE
    LAST_CHANGE=$NOW
  elif [ "$SIZE" -gt "$LAST_SIZE" ]; then
    LAST_SIZE=$SIZE
    LAST_CHANGE=$NOW
  fi

  NEW=""
  if [ -f "$LOG" ] && [ "$SIZE" -gt "$START_BYTES" ]; then
    NEW=$(tail -c "+$((START_BYTES + 1))" "$LOG" 2>/dev/null)
  fi

  if [ -n "$NEW" ]; then
    NTD=$(printf '%s\n' "$NEW" | grep -c 'Nothing to do')
    # 最后一条下载进度 / 最后一次校验完成 的行号
    LASTDL=$(printf '%s\n' "$NEW" | grep -n '正在下载更新\|Downloading \|Downloading chunks' | tail -1 | cut -d: -f1)
    VC=$(printf '%s\n' "$NEW" | grep -n 'Verification complete' | tail -1 | cut -d: -f1)
    DONE=0
    # 1) 见过两次 Nothing to do（最稳）
    [ "$NTD" -ge 2 ] && DONE=1
    # 2) 校验完成发生在最后一次下载之后 = 这轮更新已经装完
    #    （不能只看 Verification complete：启动时先验一遍，之后才下载）
    if [ -n "$VC" ] && { [ -z "$LASTDL" ] || [ "$VC" -gt "$LASTDL" ]; }; then
      DONE=1
    fi
    if [ "$DONE" = 1 ]; then
      say "检测到更新完成（Nothing to do×${NTD}），收工"
      kill_steam
      if [ "$QUIET" = 1 ]; then
        "$STEAMFIX" auto >/dev/null 2>&1
      else
        "$STEAMFIX" auto
      fi
      # 顺手报告 Steam 这次到底读了哪份主机列表（缓存 or 内置）
      if [ -x "$TOOLS/netpick" ]; then
        "$TOOLS/netpick" verify 2>/dev/null | tail -3 | sed 's/^/  /'
      fi
      echo "prewarm=ok"
      exit 0
    fi
  fi

  if [ $((NOW - LAST_CHANGE)) -ge "$STALL" ]; then
    say "⚠️ 日志已 $((NOW - LAST_CHANGE)) 秒没有新增，判定卡住"
    kill_steam
    if [ "$QUIET" = 1 ]; then
      echo "prewarm=stalled"
    else
      echo "prewarm=stalled"
      echo "---- bootstrap_log 最后 15 行 ----"
      [ -f "$LOG" ] && tail -n 15 "$LOG"
      LAST_HOST=$(grep -oE 'https://[A-Za-z0-9._-]+' "$LOG" 2>/dev/null | tail -1 | sed 's#^https://##')
      echo "last_download_host=${LAST_HOST:-unknown}"
    fi
    exit 2
  fi

  if [ "$ELAPSED" -ge "$TIMEOUT" ]; then
    say "⚠️ 超过 ${TIMEOUT} 秒还没完成"
    kill_steam
    echo "prewarm=timeout"
    exit 4
  fi

  if [ "$QUIET" != 1 ] && [ "$NOW" -ge "$NEXT_NOTE" ]; then
    say "等待中… ${ELAPSED}s，日志 ${SIZE} 字节（新增 $((SIZE - START_BYTES))）"
    NEXT_NOTE=$((NOW + 30))
  fi
done
