def warn(msg):
    sys.stderr.write("appscan: %s\n" % msg)


def safe_str(value):
    """把可能含 surrogate 的字符串变成可安全 JSON 序列化的 UTF-8 文本。"""
    if value is None:
        return ""
    if not isinstance(value, str):
        value = str(value)
    try:
        value.encode("utf-8")
        return value
    except UnicodeEncodeError:
        return value.encode("utf-8", "replace").decode("utf-8")


def norm_rel(path):
    return path.replace(os.sep, "/")


def mtime(path):
    try:
        return os.path.getmtime(path)
    except OSError:
        return 0.0


def atomic_write_bytes(dst, data):
    dirname = os.path.dirname(dst) or "."
    fd, tmp = tempfile.mkstemp(prefix=".tmp-", suffix=".part", dir=dirname)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, dst)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def atomic_write_text(dst, text):
    dirname = os.path.dirname(dst) or "."
    fd, tmp = tempfile.mkstemp(prefix=".tmp-", suffix=".part", dir=dirname)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, dst)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def load_json(path):
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


