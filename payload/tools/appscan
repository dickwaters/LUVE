# PE 图标提取
# ---------------------------------------------------------------------------

def _u16(buf, off):
    return struct.unpack_from("<H", buf, off)[0]


def _rva_to_off(sections, rva):
    for vaddr, vsize, rawptr, rawsize in sections:
        span = vsize if vsize > rawsize else rawsize
        if vaddr <= rva < vaddr + span:
            delta = rva - vaddr
            if delta >= rawsize:
                return None
            return rawptr + delta
    return None


def _read_rva(f, sections, rva, size, fsize):
    if size <= 0 or size > fsize:
        return None
    off = _rva_to_off(sections, rva)
    if off is None or off < 0 or off + size > fsize:
        return None
    f.seek(off)
    data = f.read(size)
    if len(data) != size:
        return None
    return data


def _read_dir_entries(f, sections, base, rel_off, fsize):
    """读资源目录，返回 [(name_id, offset_field), ...]。"""
    if rel_off < 0 or rel_off > 0x10000000:
        return []
    hdr = _read_rva(f, sections, base + rel_off, 16, fsize)
    if not hdr:
        return []
    named = _u16(hdr, 12)
    ids = _u16(hdr, 14)
    total = named + ids
    if total <= 0 or total > 8192:
        return []
    raw = _read_rva(f, sections, base + rel_off + 16, total * 8, fsize)
    if not raw:
        return []
    out = []
    for i in range(total):
        name_id, off = struct.unpack_from("<II", raw, i * 8)
        out.append((name_id, off))
    return out


def _pe_sections(f, fsize):
    """解析 DOS/PE 头，返回 (sections, rsrc_rva, rsrc_size)。"""
    f.seek(0)
    dos = f.read(64)
    if len(dos) < 64 or dos[:2] != b"MZ":
        return None
    e_lfanew = struct.unpack_from("<I", dos, 0x3C)[0]
    if e_lfanew < 64 or e_lfanew + 24 > fsize:
        return None
    f.seek(e_lfanew)
    nt = f.read(24)
    if len(nt) < 24 or nt[:4] != b"PE\0\0":
        return None
    nsec = _u16(nt, 6)
    optsize = _u16(nt, 20)
    if nsec <= 0 or nsec > 96 or optsize < 64:
        return None
    opt_off = e_lfanew + 24
    if opt_off + optsize > fsize:
        return None
    f.seek(opt_off)
    opt = f.read(optsize)
    if len(opt) < optsize:
        return None
    magic = _u16(opt, 0)
    if magic == 0x10B:          # PE32
        nrva_off, dd_off = 92, 96
    elif magic == 0x20B:        # PE32+
        nrva_off, dd_off = 108, 112
    else:
        return None
    if optsize < dd_off + 3 * 8:
        return None
    num_rva = struct.unpack_from("<I", opt, nrva_off)[0]
    if num_rva < 3:
        return None
    rsrc_rva, rsrc_size = struct.unpack_from("<II", opt, dd_off + 2 * 8)
    if rsrc_rva == 0 or rsrc_size == 0:
        return None
    # 注意：rsrc_rva 是内存 RVA，不是文件偏移，不能直接与文件大小比较
    if rsrc_size > fsize:
        return None

    sec_off = opt_off + optsize
    if sec_off + nsec * 40 > fsize:
        return None
    f.seek(sec_off)
    raw_secs = f.read(nsec * 40)
    if len(raw_secs) != nsec * 40:
        return None
    sections = []
    for i in range(nsec):
        base = i * 40
        vsize, vaddr, rawsize, rawptr = struct.unpack_from("<IIII", raw_secs, base + 8)
        sections.append((vaddr, vsize, rawptr, rawsize))
    return sections, rsrc_rva, rsrc_size


def _find_icon_groups(f, sections, base, fsize):
    """返回 (groups, icons)。groups 为 [(group_id, rva, size)]；icons 为 {id: (rva,size)}。"""
    groups = []
    icons = {}
    for name_id, off in _read_dir_entries(f, sections, base, 0, fsize):
        if name_id & 0x80000000:        # 命名类型（非 RT_* 数字 id）跳过
            continue
        type_id = name_id & 0xFFFF
        if type_id not in (3, 14):
            continue
        if not (off & 0x80000000):
            continue
        sub = off & 0x7FFFFFFF
        for sub_name, sub_off in _read_dir_entries(f, sections, base, sub, fsize):
            if sub_name & 0x80000000:   # 命名资源不参与（图标都是数字 id）
                continue
            res_id = sub_name & 0xFFFF
            if not (sub_off & 0x80000000):
                continue
            lang_off = sub_off & 0x7FFFFFFF
            leaves = _read_dir_entries(f, sections, base, lang_off, fsize)
            if not leaves:
                continue
            taken = False
            for _lang, leaf_off in leaves:
                if leaf_off & 0x80000000:   # 叶子不该再是子目录
                    continue
                de = _read_rva(f, sections, base + (leaf_off & 0x7FFFFFFF), 16, fsize)
                if not de:
                    continue
                data_rva, data_size = struct.unpack_from("<II", de, 0)
                if data_size <= 0 or data_size > MAX_ICON_BYTES:
                    continue
                if type_id == 14:
                    groups.append((res_id, data_rva, data_size))
                    taken = True
                else:
                    if res_id not in icons:
                        icons[res_id] = (data_rva, data_size)
                    taken = True
                if taken:
                    break
    return groups, icons


def _group_entries(f, sections, rva, size, fsize):
    """解析 RT_GROUP_ICON 数据，返回 GRPICONDIRENTRY 字典列表。"""
    data = _read_rva(f, sections, rva, min(size, 65536), fsize)
    if not data or len(data) < 6:
        return []
    if _u16(data, 0) != 0 or _u16(data, 2) != 1:
        return []
    count = _u16(data, 4)
    if count <= 0 or count > 64:
        return []
    if len(data) < 6 + count * 14:
        return []
    out = []
    for i in range(count):
        off = 6 + i * 14
        bw, bh, bcc, bres, planes, bpp, nbytes, nid = struct.unpack_from(
            "<BBBBHHIH", data, off)
        out.append({
            "width": bw, "height": bh, "colorcount": bcc, "reserved": bres,
            "planes": planes, "bpp": bpp, "bytes": nbytes, "id": nid,
        })
    return out


def _sips_ico_to_png(ico_path, png_path):
    """调 sips 把 .ico 转成 .png，成功返回 True。"""
    if not os.path.exists(SIPS):
        return False
    try:
        proc = subprocess.run(
            [SIPS, "-s", "format", "png", ico_path, "--out", png_path],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10,
        )
    except Exception:
        return False
    if proc.returncode != 0:
        return False
    try:
        with open(png_path, "rb") as f:
            head = f.read(8)
    except OSError:
        return False
    return head.startswith(b"\x89PNG\r\n\x1a\n")


def _write_ico(icon_data, entry, icon_dir):
    """把单条 RT_ICON 位图包成 .ico，返回临时文件路径（调用方负责删除）。"""
    header = struct.pack("<HHH", 0, 1, 1)
    dirent = struct.pack(
        "<BBBBHHII",
        entry["width"], entry["height"], entry["colorcount"], 0,
        entry["planes"], entry["bpp"], len(icon_data), 22,
    )
    fd, tmp = tempfile.mkstemp(prefix=".ico-", suffix=".ico", dir=icon_dir)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(header)
            f.write(dirent)
            f.write(icon_data)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    return tmp


def icon_cache_path(real_exe):
    digest = hashlib.sha1(real_exe.encode("utf-8", "replace")).hexdigest()[:16]
    return os.path.join(ART_APPS_DIR, digest + ".png")


def extract_icon(exe_path, real_exe, icon_dir):
    """提取 exe 的图标到 PNG。返回 (png_path_or_empty, status)。

    status: cached / made / fail
    """
    dst = icon_cache_path(real_exe)
    try:
        if os.path.isfile(dst) and mtime(dst) >= mtime(exe_path):
            return dst, "cached"
    except Exception:
        pass

    fsize = 0
    try:
        fsize = os.path.getsize(exe_path)
    except OSError:
        return "", "fail"
    if fsize <= 0 or fsize > MAX_PE_SIZE:
        return "", "fail"

    tmp_ico = None
    tmp_png = None
    try:
        with open(exe_path, "rb") as f:
            parsed = _pe_sections(f, fsize)
            if not parsed:
                return "", "fail"
            sections, rsrc_rva, rsrc_size = parsed
            groups, icons = _find_icon_groups(f, sections, rsrc_rva, fsize)
            if not groups or not icons:
                return "", "fail"

            candidates = []
            for gid, grva, gsize in groups:
                for entry in _group_entries(f, sections, grva, gsize, fsize):
                    aid = entry["id"] & 0xFFFF
                    if aid not in icons:
                        continue
                    area = (entry["width"] or 256) * (entry["height"] or 256)
                    candidates.append((area, entry["bpp"], gid, aid, entry))
            if not candidates:
                return "", "fail"
            candidates.sort(key=lambda c: (c[0], c[1]), reverse=True)

            for _area, _bpp, _gid, aid, entry in candidates:
                irva, isize = icons[aid]
                icon_data = _read_rva(f, sections, irva, isize, fsize)
                if not icon_data:
                    continue
                if icon_data.startswith(b"\x89PNG"):
                    # Vista+ 常见：RT_ICON 里直接就是 PNG
                    atomic_write_bytes(dst, icon_data)
                    return dst, "made"
                tmp_ico = _write_ico(icon_data, entry, icon_dir)
                fd, tmp_png = tempfile.mkstemp(
                    prefix=".png-", suffix=".png", dir=icon_dir)
                os.close(fd)
                if _sips_ico_to_png(tmp_ico, tmp_png):
                    os.replace(tmp_png, dst)
                    tmp_png = None
                    return dst, "made"
                try:
                    os.unlink(tmp_png)
                except OSError:
                    pass
                tmp_png = None
                try:
                    os.unlink(tmp_ico)
                except OSError:
                    pass
                tmp_ico = None
            return "", "fail"
    except Exception:
        return "", "fail"
    finally:
        for tmp in (tmp_ico, tmp_png):
            if tmp:
                try:
                    os.unlink(tmp)
                except OSError:
                    pass


