def discover_roots():
    """返回 [(bottle_name, drive_c_path)]，主 prefix 记为 main。"""
    roots = []
    if os.path.isdir(PREFIX_DRIVE_C):
        roots.append(("main", PREFIX_DRIVE_C))
    try:
        names = sorted(os.listdir(BOTTLES_DIR))
    except OSError:
        names = []
    for name in names:
        if name.startswith("."):
            continue
        dc = os.path.join(BOTTLES_DIR, name, "drive_c")
        if os.path.isdir(dc):
            roots.append((name, dc))
    return roots


def locate_in_roots(real_path, roots):
    """返回 (bottle, drive_c, rel) 或 (None, None, None)。"""
    for bottle, dc in roots:
        try:
            rdc = os.path.realpath(dc)
        except OSError:
            rdc = dc
        if real_path == rdc or real_path.startswith(rdc + os.sep):
            rel = os.path.relpath(real_path, rdc)
            return bottle, rdc, norm_rel(rel)
    return None, None, None


def load_playtime():
    try:
        data = load_json(PLAYTIME_JSON)
        if isinstance(data, dict):
            return data
    except Exception as exc:
        warn("读取 playtime.json 失败（按 0 处理）: %s" % exc)
    return {}


def playtime_seconds(playtime, appid):
    if not appid:
        return 0
    value = playtime.get(str(appid))
    if value is None:
        return 0
    try:
        seconds = int(value)
    except (TypeError, ValueError):
        return 0
    return seconds if seconds > 0 else 0


def load_recipes():
    """读取 recipes/*.json，返回原始记录列表。"""
    out = []
    for path in sorted(glob.glob(os.path.join(RECIPES_DIR, "*.json"))):
        if not os.path.isfile(path):
            continue
        try:
            data = load_json(path)
        except Exception as exc:
            warn("跳过无法解析的 recipe %s: %s" % (os.path.basename(path), exc))
            continue
        if not isinstance(data, dict):
            continue
        appid = str(data.get("appid") or "").strip()
        if not appid:
            appid = os.path.basename(path)[:-5]
        exe = data.get("exe") or ""
        if not isinstance(exe, str):
            continue
        name = str(data.get("name_zh") or data.get("name") or "").strip()
        if not name:
            name = "App " + appid
        out.append({
            "appid": appid,
            "name": name,
            "exe": exe.strip(),
            "engine": str(data.get("engine") or ""),
            "publisher": str(data.get("publisher") or ""),
            "path": path,
        })
    return out


def _steam_common_dirs(roots, prefix_dc):
    dirs = []
    main_common = os.path.join(prefix_dc, STEAM_COMMON_REL)
    if os.path.isdir(main_common):
        dirs.append(main_common)
    for _bottle, dc in roots:
        common = os.path.join(dc, STEAM_COMMON_REL)
        if os.path.isdir(common) and common not in dirs:
            dirs.append(common)
    return dirs


def _strip_wine_prefix(raw, roots, common_dirs):
    """把 recipe 里可能出现的 Windows 路径拆成候选宿主路径。"""
    norm = raw.replace("\\", "/").strip().strip('"').strip("'")
    out = []

    def add(path):
        if path and path not in out:
            out.append(path)

    low = norm.lower()
    # 路径里带 steamapps/common 的，直接截取后半段
    marker = "steamapps/common/"
    if marker in low:
        suffix = norm[low.index(marker) + len(marker):]
        for common in common_dirs:
            add(os.path.join(common, suffix))
    if "drive_c/" in low:
        suffix = norm[low.index("drive_c/") + len("drive_c/"):]
        add(os.path.join(PREFIX_DRIVE_C, suffix))

    if re.match(r"^[A-Za-z]:", norm):
        drive = norm[0].lower()
        rest = norm[2:].lstrip("/")
        if drive == "z":
            add("/" + rest)                     # Wine 里 Z: 映射宿主根
            for common in common_dirs:
                add(os.path.join(common, rest))
        elif drive == "c":
            for _bottle, dc in roots:
                add(os.path.join(dc, rest))
        for common in common_dirs:
            add(os.path.join(common, rest))
    elif norm.startswith("/"):
        add(norm)
        for _bottle, dc in roots:
            add(os.path.join(dc, norm.lstrip("/")))
        for common in common_dirs:
            add(os.path.join(common, norm.lstrip("/")))
    else:
        for common in common_dirs:
            add(os.path.join(common, norm))
        add(os.path.join(PREFIX_DRIVE_C, norm))
    return out


def _search_basename(common_dirs, basename, max_depth=4):
    """兜底：在 steamapps/common 下按文件名找（大小写不敏感）。"""
    wanted = basename.lower()
    for common in common_dirs:
        base_depth = common.rstrip(os.sep).count(os.sep)

        def onerror(_exc):
            return None

        for dirpath, dirnames, filenames in os.walk(
                common, topdown=True, onerror=onerror):
            depth = dirpath.rstrip(os.sep).count(os.sep) - base_depth
            if depth >= max_depth:
                dirnames[:] = []
            for fn in filenames:
                if fn.lower() == wanted:
                    return os.path.join(dirpath, fn)
    return None


def resolve_recipe_exe(recipe, roots, common_dirs):
    raw = recipe["exe"]
    if not raw:
        return None
    for cand in _strip_wine_prefix(raw, roots, common_dirs):
        try:
            if os.path.isfile(cand):
                return os.path.realpath(cand)
        except OSError:
            continue
    # 再来一次按文件名兜底
    base = raw.replace("\\", "/").rstrip("/").rsplit("/", 1)[-1]
    if base:
        found = _search_basename(common_dirs, base)
        if found:
            try:
                return os.path.realpath(found)
            except OSError:
                return None
    return None


def classify_path(rel_lower, name_lower, stem_lower):
    """返回 system / None（仅按路径与文件名规则判断）。"""
    marked = "/" + rel_lower
    for marker in SYSTEM_PATH_MARKERS:
        if marker in marked:
            return "system"
    # Steam 自己的内部可执行文件（Steam.exe 之外）都不是给用户点的
    if "/steam/" in marked and "/steamapps/" not in marked:
        return "system"
    for pattern in SYSTEM_NAME_PATTERNS:
        if pattern.endswith("*"):
            if stem_lower.startswith(pattern[:-1]) or name_lower.startswith(pattern[:-1]):
                return "system"
        elif name_lower == pattern or stem_lower == pattern:
            return "system"
    return None


def subtitle_for(rel):
    parts = [p for p in rel.split("/") if p]
    if len(parts) >= 2:
        return parts[-2]
    return ""


def slug_for(rel):
    slug = rel
    if slug.lower().endswith(".exe"):
        slug = slug[:-4]
    return slug.replace("/", "_")


def scan(show_all, with_icons, cache_path):
    t_start = time.time()
    playtime = load_playtime()
    roots = discover_roots()
    if not roots:
        raise FatalError("找不到任何 Wine prefix 或 bottle（检查 %s）" % PREFIX_DRIVE_C)

    apps = []
    used_paths = set()      # realpath 去重
    used_ids = set()

    def add_app(app):
        rp = app["_real"]
        if rp in used_paths:
            return False
        if app["id"] in used_ids:
            if app["kind"] in ("game", "steam"):
                return False
            app["id"] = app["id"] + "_" + hashlib.sha1(
                rp.encode("utf-8", "replace")).hexdigest()[:6]
        used_paths.add(rp)
        used_ids.add(app["id"])
        apps.append(app)
        return True

    # ---- Steam 本体 ----
    steam_exe = None
    steam_candidate = os.path.join(PREFIX_DRIVE_C, STEAM_EXE_REL)
    try:
        if os.path.isfile(steam_candidate):
            steam_exe = os.path.realpath(steam_candidate)
    except OSError:
        steam_exe = None
    steam_dir = os.path.join(PREFIX_DRIVE_C, STEAM_REL)
    if steam_exe is None and os.path.isdir(steam_dir):
        try:
            for fn in os.listdir(steam_dir):
                if fn.lower() == "steam.exe":
                    cand = os.path.join(steam_dir, fn)
                    if os.path.isfile(cand):
                        steam_exe = os.path.realpath(cand)
                        break
        except OSError:
            pass
    if steam_exe:
        add_app({
            "id": "steam",
            "name": "Steam",
            "kind": "steam",
            "exe": steam_exe,
            "bottle": "main",
            "appid": "",
            "icon": "",
            "seconds": 0,
            "engine": "",
            "subtitle": "Valve",
            "_real": steam_exe,
            "_rel": STEAM_EXE_REL,
        })

    # ---- recipes → games ----
    common_dirs = _steam_common_dirs(roots, PREFIX_DRIVE_C)
    recipes = load_recipes()
    for recipe in recipes:
        real = resolve_recipe_exe(recipe, roots, common_dirs)
        if not real:
            warn("recipe %s 的 exe 找不到: %s" % (recipe["appid"], recipe["exe"]))
            continue
        bottle, _dc, rel = locate_in_roots(real, roots)
        if bottle is None:
            bottle, rel = "main", os.path.basename(real)
        add_app({
            "id": "game:" + recipe["appid"],
            "name": recipe["name"],
            "kind": "game",
            "exe": real,
            "bottle": bottle,
            "appid": recipe["appid"],
            "icon": "",
            "seconds": playtime_seconds(playtime, recipe["appid"]),
            "engine": recipe["engine"],
            "subtitle": recipe["publisher"] or subtitle_for(rel),
            "_real": real,
            "_rel": rel,
        })

    # ---- 逐 root 遍历其它 exe ----
    def walk_error(exc):
        warn("遍历出错（已跳过）: %s" % exc)

    for bottle, dc in roots:
        walker = os.walk(dc, topdown=True, followlinks=False, onerror=walk_error)
        for dirpath, dirnames, filenames in walker:
            try:
                depth = dirpath[len(dc):].count(os.sep)
            except Exception:
                depth = 0
            if depth >= MAX_WALK_DEPTH:
                dirnames[:] = []
            dirnames.sort()
            for fn in sorted(filenames):
                if not fn.lower().endswith(".exe"):
                    continue
                full = os.path.join(dirpath, fn)
                try:
                    if not os.path.isfile(full):
                        continue
                    real = os.path.realpath(full)
                except OSError:
                    continue
                if real in used_paths:
                    continue
                b2, _dc2, rel = locate_in_roots(real, roots)
                if b2 is None:
                    b2 = bottle
                    rel = norm_rel(os.path.relpath(full, dc))
                rel_lower = rel.lower()
                name_lower = fn.lower()
                stem_lower = name_lower[:-4] if name_lower.endswith(".exe") else name_lower
                sub = subtitle_for(rel)
                name = fn[:-4] if fn.lower().endswith(".exe") else fn

                if rel_lower == STEAM_EXE_REL.lower() or (
                        name_lower == "steam.exe"
                        and os.path.basename(os.path.dirname(rel_lower)) == "steam"):
                    kind = "steam"
                    appid = ""
                    name_out = "Steam"
                    sub = "Valve"
                    app_id = "steam" if b2 == "main" else "steam:" + b2
                elif classify_path(rel_lower, name_lower, stem_lower) == "system":
                    kind = "system"
                    appid = ""
                    name_out = name
                    app_id = "app:%s:%s" % (b2, slug_for(rel))
                else:
                    kind = "app"
                    appid = ""
                    name_out = name
                    app_id = "app:%s:%s" % (b2, slug_for(rel))
                    # 双扩展名等极端情况下 name 为空则用目录名
                    if not name_out:
                        name_out = os.path.basename(os.path.dirname(rel)) or fn

                add_app({
                    "id": app_id,
                    "name": name_out,
                    "kind": kind,
                    "exe": real,
                    "bottle": b2,
                    "appid": appid,
                    "icon": "",
                    "seconds": 0,
                    "engine": "",
                    "subtitle": sub,
                    "_real": real,
                    "_rel": rel,
                })

    # ---- 美术资源：游戏优先用 artfetch 抓回来的 Steam 美术 ----
    # icon = 方形（简约模式图标墙用），art = 宽图（预览模式封面用）
    for a in apps:
        a.setdefault("art", "")
        if a["kind"] == "game" and a.get("appid"):
            d = os.path.join(ART_DIR, a["appid"])
            for fn in ("header.jpg", "capsule.jpg", "cover.jpg"):
                fp = os.path.join(d, fn)
                if a.get("art") or not os.path.isfile(fp):
                    continue
                a["art"] = fp

    # ---- 过滤 + 排序 ----
    if not show_all:
        apps = [a for a in apps if a["kind"] != "system"]
    apps.sort(key=lambda a: (KIND_WEIGHT.get(a["kind"], 9), a["name"].lower()))

    # ---- 图标 ----
    icon_stats = {"ok": 0, "fail": 0, "cached": 0, "skipped": 0}
    if with_icons:
        try:
            os.makedirs(ART_APPS_DIR, exist_ok=True)
        except OSError as exc:
            raise FatalError("无法创建图标目录 %s: %s" % (ART_APPS_DIR, exc))
        attempted = 0
        for app in apps:
            if app["kind"] == "system":
                icon_stats["skipped"] += 1
                continue
            if app.get("icon"):
                # 已经有 Steam 缓存的方形图标（artfetch 抓的），不用再解 exe
                icon_stats["cached"] += 1
                icon_stats["ok"] += 1
                continue
            if attempted >= ICON_LIMIT:
                icon_stats["skipped"] += 1
                continue
            if time.time() - t_start > ICON_BUDGET_SEC:
                icon_stats["skipped"] += 1
                continue
            attempted += 1
            icon, status = extract_icon(app["exe"], app["_real"], ART_APPS_DIR)
            if not icon and app.get("appid"):
                # exe 里解不出图标（比如超大 exe），退回 Steam 缓存的小图标
                fp = os.path.join(ART_DIR, app["appid"], "icon_square.png")
                if os.path.isfile(fp):
                    icon = fp
                    status = "cached"
            app["icon"] = icon
            if status == "made":
                icon_stats["ok"] += 1
            elif status == "cached":
                icon_stats["cached"] += 1
                icon_stats["ok"] += 1
            else:
                icon_stats["fail"] += 1
        if icon_stats["skipped"] and attempted >= ICON_LIMIT:
            warn("图标只提取了前 %d 个应用，其余跳过" % ICON_LIMIT)
        if time.time() - t_start > ICON_BUDGET_SEC:
            warn("图标提取达到 %.0f 秒预算，剩余跳过" % ICON_BUDGET_SEC)

    # ---- 输出结构 ----
    out_apps = []
    for app in apps:
        out_apps.append({
            "id": safe_str(app["id"]),
            "name": safe_str(app["name"]),
            "kind": app["kind"],
            "exe": safe_str(app["exe"]),
            "bottle": safe_str(app["bottle"]),
            "appid": safe_str(app["appid"]),
            "icon": safe_str(app["icon"]),
            "art": safe_str(app.get("art", "")),
            "seconds": int(app["seconds"]),
            "engine": safe_str(app["engine"]),
            "subtitle": safe_str(app["subtitle"]),
        })
    result = {
        "generated": int(time.time()),
        "count": len(out_apps),
        "apps": out_apps,
    }

    # ---- 写缓存 ----
    cache_dir = os.path.dirname(os.path.abspath(cache_path)) or "."
    try:
        os.makedirs(cache_dir, exist_ok=True)
    except OSError as exc:
        raise FatalError("无法创建缓存目录 %s: %s" % (cache_dir, exc))
    text = json.dumps(result, ensure_ascii=False, indent=2) + "\n"
    try:
        atomic_write_text(cache_path, text)
    except OSError as exc:
        raise FatalError("写缓存失败 %s: %s" % (cache_path, exc))

    if with_icons:
        warn("图标: 成功 %d（其中缓存 %d），失败 %d，跳过 %d" % (
            icon_stats["ok"], icon_stats["cached"],
            icon_stats["fail"], icon_stats["skipped"]))
    warn("扫描完成: %d 个应用，%.2f 秒" % (len(out_apps), time.time() - t_start))
    return text


# ---------------------------------------------------------------------------
# 入口
# ---------------------------------------------------------------------------

USAGE = """用法: appscan [--all] [--no-icons] [--cache PATH]

  --all        连系统组件（kind=system）一起输出
  --no-icons   不提取 PE 图标
  --cache PATH 结果缓存路径（默认 $PAY/art/appscan.json）
"""


def parse_args(argv):
    show_all = False
    with_icons = True
    cache = DEFAULT_CACHE
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--all":
            show_all = True
        elif arg == "--no-icons":
            with_icons = False
        elif arg == "--cache":
            i += 1
            if i >= len(argv):
                raise UsageError("--cache 需要一个路径参数")
            cache = argv[i]
        elif arg.startswith("--cache="):
            cache = arg.split("=", 1)[1]
            if not cache:
                raise UsageError("--cache 需要一个路径参数")
        elif arg in ("-h", "--help"):
            sys.stdout.write(USAGE)
            raise SystemExit(0)
        else:
            raise UsageError("未知参数: %s" % arg)
        i += 1
    return show_all, with_icons, cache


def main(argv):
    try:
        show_all, with_icons, cache = parse_args(argv)
    except UsageError as exc:
        sys.stderr.write("appscan: %s\n\n%s" % (exc, USAGE))
        return 2
    if not os.path.isdir(PAY):
        sys.stderr.write("appscan: 找不到 SteamWine 安装目录: %s\n" % PAY)
        return 1
    try:
        text = scan(show_all, with_icons, cache)
    except FatalError as exc:
        sys.stderr.write("appscan: %s\n" % exc)
        return 1
    except Exception as exc:  # 兜底：不让任何意外把栈炸到用户脸上
        sys.stderr.write("appscan: 扫描失败: %s: %s\n" % (type(exc).__name__, exc))
        return 1
    try:
        sys.stdout.buffer.write(text.encode("utf-8"))
        sys.stdout.buffer.flush()
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        return 0
    except Exception as exc:
        sys.stderr.write("appscan: 写 stdout 失败: %s\n" % exc)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
